@model IEnumerable<MvcFreelan.Models.Mypays.Mypay>

@{
    ViewData["Title"] = "Index";
}

<div class="container">
    <br />
    <h3>House Payments List</h3>
    <br />

    <div style="border: 1px solid gray; width:300px; background-color: azure; padding: 10px">
    @if (Model.Count() > 0)
    {
        var payments = Model.ToList()[0];
        <strong>Payments Catalog</strong>
        <br />
    
        <ul>
            @foreach (var item in payments.Items)
            {
                <li>
                    @item.Text
                </li>
            }
        </ul>
    }
        <p>
            <a asp-controller="MypayTypes" asp-action="Create">Add Payment Type</a>
        </p>
    </div>

    <br />

    <h5>
        <a asp-action="Create">Add House Payment</a>
    </h5>
    <br />

    <h5>
        <h5>Payments List</h5>
    </h5>
    <table class="table">
        <thead>
            <tr>
                @* <th>
                    @Html.DisplayNameFor(model => model.SelectedMypaytypeId)
                </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.MypayName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TotalMypay)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DateCovered)
                </th>
                @* <th>
                    @Html.DisplayNameFor(model => model.DateAdded)
                </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.Note)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AspUser)
                </th>
                @* <th>
                    @Html.DisplayNameFor(model => model.Active)
                </th> *@
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                @* <td>
                    @Html.DisplayFor(modelItem => item.SelectedMypaytypeId)
                </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.MypayName)
                    </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalMypay)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateCovered)
                </td>
                @* <td>
                    @Html.DisplayFor(modelItem => item.DateAdded)
                </td> *@
                <td>
                    @Html.DisplayFor(modelItem => item.Note)
                </td>
                <td>
                @if (item.AspUser.Length < 5)
                {
                        @Html.DisplayFor(modelItem => item.AspUser)
                }
                </td>
                @* <td>
                    @Html.DisplayFor(modelItem => item.Active)
                </td> *@

                @if (item.AspUser.Length < 5)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                }
            </tr>
    }
        </tbody>
    </table>

</div>