@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> signInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* <environment include="Development">      viene de launchSettings.json
        todos los scripts y boostraps locales
    </environment>
    <environment exclude="Development">
        Los necesarios CDN
    </environment> *@


    <title>@ViewData["Title"] - René M.</title>
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcFreelan.styles.css" asp-append-version="true" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
</head>
<body>
    <!-- Barra de navegación -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">M.Sc. René Montoya</a>
            <button 
                class="navbar-toggler" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#navbarNav"
                    style="color:black; background-color:#2c3e50" value="☰">
                <span class="navbar-toggler-icon" style="filter: invert(1);">☰</span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li style="background-color: darkred">
                            <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users">≡</a>
                        </li>
                    }

                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ReneCV">CV-René</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Mtrx">Screen Saver</a></li>

                    <!-- Dropdown Menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"  data-bs-toggle="dropdown" aria-expanded="false">Examples</a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-controller="QR" asp-action="Index">QR</a></li>
                            <li><a class="dropdown-item" asp-controller="Elevator" asp-action="Index">Elevator</a></li>
                            <li><a class="dropdown-item" asp-controller="Rentas" asp-action="Index">Rentas</a></li>
                            <li><a class="dropdown-item" asp-controller="Mypays" asp-action="Index">House Pays</a></li>
                            
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Qualitaz">Quálitaz</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="MotSeg">Motion Segmentation</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="d-flex flex-row-reverse bd-highlight">
                @if (signInManager.IsSignedIn(User))
                {
                    <span>
                        <form method="post" asp-action="Logout" asp-controller="Account">
                            <button type="submit" class="btn btn-sm btn-primary" style="width:auto">
                                Logout @User.Identity.Name
                            </button>
                        </form>
                    </span>
                }
                else
                {
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>




    <!-- Pie de página -->
    <footer>
        <div class="container">
            <p>
                &copy; 2025 René. All rights reserved.
            </p>
        </div>
    </footer>


    @* <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false) *@


    @* CLICK ON IMGE TO FULL SCREEN *@
    <script>
        $(document).ready(
            function(){
                $("img").click(
                    function() {
                        this.requestFullscreen()
                    }
            )}
        );
    </script>
</body>
</html>
