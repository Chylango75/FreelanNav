@model MvcFreelan.Models.Mypays.MypayType

@{
    ViewData["Title"] = "Edit";
}


<div class="container">
    <h3></h3><br />
    <h3>Edit Mypay Type</h3>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="MypayName" class="control-label"></label>
                    <input asp-for="MypayName" class="form-control" />
                    <span asp-validation-for="MypayName" class="text-danger"></span>
                </div>

                <div style="display:none">
                    <div class="form-group">
                        <label asp-for="Created" class="control-label"></label>
                        <input asp-for="Created" class="form-control" />
                        <span asp-validation-for="Created" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                        </label>
                    </div>
                </div>

                <br />
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
    <br />
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>