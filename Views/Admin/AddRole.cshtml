<div class="container">
    <br />
    <h4>Add Role</h4>
    <form method="post" asp-action="AddRole">
        <input type="text" id="roleName" name="roleName" class="form-control" />
        <br />
        <button type="submit" class="btn btn-sm btn-primary" style="width:auto">
            Add
        </button>
        <a class="btn btn-sm btn-primary" asp-action="Roles">Cancel</a>
    </form>
    <br />
</div>
